{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "arch",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": " --> ",
    "color": {
      "keys": "blue",
      "title": "red"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "",
      "format": "{sysname} {release}"
    },
    {
      "type": "wm",
      "key": "",
      "format": ""
    },
    {
      "type": "cpu",
      "key": "",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰢮",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key":  "",
      "format": "{total} <{percentage}>"
    },
    {
      "type":"disk",
      "key": "󰋊",
      "format": "{size-total}/{size-used} ({filesystem})"
    },
    {
      "type":"terminal",
      "key": "",
      "format": "{pretty-name}"
    },
    {
       "type":"shell",
       "key": "",
       "format": "{pretty-name}"
    },
    {
       "type":"packages",
       "key": "",
       "format": "Pacman {pacman} Flatpak {flatpak-all} Appimage {appimage}"
    },

    "break",

    {
       "type":"colors",
       "symbol": "block"
    }
  ]
}
